{
  "version": "2.0",
  "game_id": "moca-demo",
  "name": "Moca 示例通用游戏包",
  "welcome": "这是一个用于验证 Moca 多游戏底座 Schema 渲染与免费/VIP 权限隔离的示例包。",
  "license": "Apache-2.0",
  "resource": [
    {
      "name": "default",
      "path": "./resource"
    }
  ],
  "controller": {
    "ADB": {
      "type": "Adb",
      "config": {
        "execution_mode": "background"
      }
    },
    "Win32": {
      "type": "Win32",
      "config": {
        "title_regex": ".*",
        "execution_mode": "foreground_exclusive"
      }
    }
  },
  "task": {
    "DailyRoutine": {
      "label": "每日日常与清体力",
      "description": "开源免费任务：自动登录、领取邮件奖励并清理指定材料副本。",
      "entry": "DailyStart",
      "group": "日常托管",
      "tier": "free",
      "option": ["stamina_target", "auto_use_potion", "custom_note"]
    },
    "WeeklyBoss": {
      "label": "周本速刷",
      "description": "开源免费任务：每周固定次数周本清理。",
      "entry": "WeeklyStart",
      "group": "日常托管",
      "tier": "free",
      "option": ["weekly_times"]
    },
    "CloudRogue": {
      "label": "肉鸽全自动决策",
      "description": "VIP 云端大脑：实时采集祝福/事件/血量状态，云端下发最优决策树。",
      "entry": "CloudRogueEntry",
      "group": "高难与活动 (VIP)",
      "tier": "vip",
      "cloud_strategy": "rogue_decision_v1",
      "option": ["rogue_difficulty"]
    }
  },
  "option": {
    "stamina_target": {
      "type": "select",
      "label": "体力目标副本",
      "default": "exp",
      "items": [
        { "name": "经验素材本", "value": "exp" },
        { "name": "突破材料本", "value": "ascension" },
        { "name": "金币/信用点本", "value": "credit" }
      ]
    },
    "auto_use_potion": {
      "type": "boolean",
      "label": "自动消耗即将过期的体力药",
      "default": true
    },
    "weekly_times": {
      "type": "select",
      "label": "周本次数",
      "default": 3,
      "items": [
        { "name": "1 次", "value": 1 },
        { "name": "3 次", "value": 3 }
      ]
    },
    "rogue_difficulty": {
      "type": "select",
      "label": "肉鸽难度策略",
      "default": "balanced",
      "items": [
        { "name": "稳健通关优先", "value": "safe" },
        { "name": "均衡图鉴刷分", "value": "balanced" },
        { "name": "高难冲层模式", "value": "hardcore" }
      ]
    },
    "custom_note": {
      "type": "input",
      "label": "自定义编队备注",
      "default": "主C配队1",
      "input_type": "text"
    }
  }
}

    "action": "InputText",
    "input_text": "",
    "next": [
      "AP_RedeemClickConfirm"
    ]
  },
  "AP_RedeemClickConfirm": {
    "doc": "OCR 识别并点击绿色「确认」兑换按钮",
    "recognition": "OCR",
    "expected": "确认",
    "roi": [580, 360, 560, 260],
    "action": "Click",
    "next": [],
    "timeout": 4000
  },
  "AP_RedeemFinishCleanup": {
    "doc": "全部兑换码完成后关闭残余结果确认框并点击取消退出兑换弹窗",
